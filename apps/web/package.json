{
  "name": "@oktavius/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bundle:check": "node scripts/assert-bundle-budget.mjs",
    "bundle:test": "vitest run scripts/assert-bundle-budget.test.mjs",
    "generate:module-contracts": "node --experimental-strip-types scripts/generate-module-contracts.ts",
    "generate:modules": "node --experimental-strip-types scripts/generate-modules.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm -w exec eslint apps/web/src apps/web/vite.config.ts apps/web/tailwind.config.ts apps/web/postcss.config.js"
  },
  "dependencies": {
    "@1771technologies/lytenyte-core": "^2.0.2",
    "@hookform/resolvers": "^5.4.0",
    "@oktavius/base-ui": "workspace:*",
    "@oktavius/i18n": "workspace:*",
    "@oktavius/reference-data": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.90.2",
    "fflate": "^0.8.3",
    "nuqs": "^2.8.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.77.0",
    "react-hotkeys-hook": "^5.3.2",
    "react-router-dom": "^7.6.1",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  }
}
